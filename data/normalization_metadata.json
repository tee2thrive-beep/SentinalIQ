{
  "version": "1.0.0",
  "project": "SentinelIQ",
  "step": "STEP 2 — Common Alert Schema & Normalization Engine",
  "target_scale": {
    "minimum": 0.0,
    "maximum": 100.0,
    "unit": "normalized score"
  },
  "factors": [
    {
      "factor_name": "normalized_severity",
      "source_field": "alert.severity",
      "level": "alert",
      "formula": "round(float(max(0, min(100, severity))), 2)",
      "scale": "0.0 - 100.0",
      "reference_min": 0,
      "reference_max": 100,
      "description": "Preserved directly from detector raw severity score on 0-100 scale."
    },
    {
      "factor_name": "normalized_confidence",
      "source_field": "alert.confidence",
      "level": "alert",
      "formula": "round(float(max(0, min(100, confidence))), 2)",
      "scale": "0.0 - 100.0",
      "reference_min": 0,
      "reference_max": 100,
      "description": "Preserved directly from detection engine confidence rating on 0-100 scale."
    },
    {
      "factor_name": "normalized_asset_importance",
      "source_field": "asset.criticality, asset.business_value",
      "level": "alert (via Asset FK)",
      "formula": "0.6 * criticality + 0.4 * business_value",
      "scale": "0.0 - 100.0",
      "reference_min": 0,
      "reference_max": 100,
      "description": "Weighted combination of target asset operational criticality and business value."
    },
    {
      "factor_name": "normalized_data_sensitivity",
      "source_field": "asset.data_sensitivity",
      "level": "alert (via Asset FK)",
      "formula": "1.0 * data_sensitivity",
      "scale": "0.0 - 100.0",
      "reference_min": 0,
      "reference_max": 100,
      "description": "Direct rating of asset data confidentiality level (PII / restricted data)."
    },
    {
      "factor_name": "normalized_business_impact",
      "source_field": "asset.criticality, asset.business_value, asset.data_sensitivity",
      "level": "alert (via Asset FK)",
      "formula": "0.5 * criticality + 0.3 * business_value + 0.2 * data_sensitivity",
      "scale": "0.0 - 100.0",
      "reference_min": 0,
      "reference_max": 100,
      "description": "Derived potential business impact composite score based on asset metadata."
    },
    {
      "factor_name": "normalized_affected_users",
      "source_field": "incident.unique_affected_users_count",
      "level": "incident (DEFERRED TO STEP 4)",
      "formula": "100.0 * log(1 + user_count) / log(1 + 1000)",
      "scale": "0.0 - 100.0",
      "reference_min": 0,
      "reference_max": 1000,
      "description": "Logarithmic saturation scaling for affected user counts. Deferred to incident clustering stage when multi-alert user counts are aggregated."
    }
  ]
}
