# SentinelIQ Environment Configuration Template
# Copy this file to .env for local runtime configuration

# Application Environment (development | production | testing)
SENTINELIQ_ENV=development

# Backend API Configuration
SENTINELIQ_API_HOST=0.0.0.0
SENTINELIQ_API_PORT=8000

# Security & CORS (Comma-separated list of allowed origins)
SENTINELIQ_CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Logging Level (DEBUG | INFO | WARNING | ERROR)
SENTINELIQ_LOG_LEVEL=INFO

# Data Directory Path
SENTINELIQ_DATA_DIR=data

# Frontend API Base URL (Exposed to Vite browser build)
VITE_API_BASE_URL=http://localhost:8000
